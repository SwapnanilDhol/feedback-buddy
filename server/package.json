{
  "name": "feedback-buddy-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply feedback-buddy --local",
    "db:migrate:remote": "wrangler d1 migrations apply feedback-buddy --remote"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.3",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261104.1": true
  }
}
