{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedbackbuddy.dev/contracts/webhook-event-v1.schema.json",
  "title": "FeedbackBuddy webhook event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "type", "occurred_at", "project", "data"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "type": { "const": "feedback.created" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "name"],
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "data": { "$ref": "feedback-object-v1.schema.json" }
  }
}
