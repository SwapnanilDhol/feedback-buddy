{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedback-loop.dev/contracts/webhook-event-v1.schema.json",
  "title": "Feedback created webhook event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "type", "occurred_at", "project", "data"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "type": { "const": "feedback.created" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feedback_id", "category", "message", "reply_requested", "context"],
      "properties": {
        "feedback_id": { "type": "string", "format": "uuid" },
        "category": { "enum": ["feedback", "bug", "idea"] },
        "message": { "type": "string" },
        "reply_requested": { "type": "boolean" },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["app_version", "build_number", "os_version", "locale", "device_family"],
          "properties": {
            "app_version": { "type": "string" },
            "build_number": { "type": "string" },
            "os_version": { "type": "string" },
            "locale": { "type": "string" },
            "device_family": { "type": "string" }
          }
        }
      }
    }
  }
}
