{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedbackbuddy.dev/contracts/feedback-submission-v1.schema.json",
  "title": "FeedbackBuddy submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "category", "message", "context"],
  "properties": {
    "schema_version": { "const": 1 },
    "category": { "enum": ["feedback", "bug", "idea"] },
    "message": { "type": "string", "minLength": 4, "maxLength": 2000 },
    "name": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 120 }
      ]
    },
    "reply_email": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "maxLength": 254, "format": "email" }
      ]
    },
    "context": { "$ref": "#/$defs/context" },
    "user": { "$ref": "#/$defs/user" }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_version", "build_number", "os_version", "locale", "device_family"],
      "properties": {
        "app_version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "build_number": { "type": "string", "minLength": 1, "maxLength": 40 },
        "os_version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "locale": { "type": "string", "minLength": 2, "maxLength": 80 },
        "device_family": { "type": "string", "minLength": 1, "maxLength": 80 },
        "device_model": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 80 }
          ]
        }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 200 }
          ]
        },
        "account_status": { "enum": ["unknown", "free", "paid"], "default": "unknown" },
        "plan": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 200 }
          ]
        },
        "entitlements": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "attributes": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": { "minLength": 1, "maxLength": 80 },
          "additionalProperties": { "type": "string", "maxLength": 500 }
        }
      }
    }
  }
}
