{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedback-loop.dev/contracts/feedback-submission-v1.schema.json",
  "title": "Feedback submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "category", "message", "context"],
  "properties": {
    "schema_version": { "const": 1 },
    "category": { "enum": ["feedback", "bug", "idea"] },
    "message": { "type": "string", "minLength": 4, "maxLength": 2000 },
    "reply_email": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "maxLength": 254, "format": "email" }
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_version", "build_number", "os_version", "locale", "device_family"],
      "properties": {
        "app_version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "build_number": { "type": "string", "minLength": 1, "maxLength": 40 },
        "os_version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "locale": { "type": "string", "minLength": 2, "maxLength": 80 },
        "device_family": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    }
  }
}
